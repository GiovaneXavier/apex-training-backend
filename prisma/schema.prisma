// Apex Training — Prisma schema
// Modelagem multi-sports via campo `detalhes` JSON em Treino e Prova.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // URL pooled (PgBouncer/Neon pooler) — runtime da app
  url       = env("DATABASE_URL")
  // URL direta (sem pooler) — usada por `prisma migrate` e introspection.
  // Neon exige isto: o pooler não suporta prepared statements/advisory locks
  // que o engine de migrations precisa.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ALUNO
  PROFESSOR
  NUTRICIONISTA
}

enum Modalidade {
  MUSCULACAO
  CORRIDA
  CICLISMO
  NATACAO
  TRIATHLON
  HYROX
  JIU_JITSU
  OUTRO
}

// PR #22 — domínio do exercício no catálogo.
// Permite filtrar a biblioteca pelo contexto do mestre/professor sem
// criar uma tabela separada (catálogo unificado mantém o picker do
// RotinaForm reusável). MUSCULACAO continua sendo o default histórico.
enum DominioExercicio {
  MUSCULACAO
  JIU_JITSU
  MOBILIDADE
  OUTRO
}

// PR #22 — tipo de movimento (mais granular que `dominio`).
// Hoje usado SÓ para JIU_JITSU, mas o enum vive em column única no
// catálogo pra permitir extensão futura (ex: TRACAO/EMPURRAO em
// musculação) sem migration destrutiva.
enum TipoMovimento {
  DRILL
  PASSAGEM
  GUARDA
  RASPAGEM
  SUBMISSAO
  ENTRADA
  SAIDA
}

enum StatusTreino {
  PENDENTE
  EM_EXECUCAO
  CONCLUIDO
  PULADO
}

enum DiaSemana {
  DOM
  SEG
  TER
  QUA
  QUI
  SEX
  SAB
}

enum AvaliadorTipo {
  ALUNO
  NUTRICIONISTA
  PROFESSOR
}

enum GrupoMuscular {
  PEITO
  COSTAS
  OMBRO
  BICEPS
  TRICEPS
  ANTEBRACO
  ABDOMEN
  GLUTEO
  QUADRICEPS
  POSTERIOR
  PANTURRILHA
  CARDIO
  CORE
  OUTRO
}

// PR #24 — Faixas adultas IBJJF.
// Sequência canônica: BRANCA → AZUL → ROXA → MARROM → PRETA.
// CORAL (vermelha+preta) e VERMELHA representam grandes mestres —
// endgame, sem meta de progresso na UI. Kids (cinza, amarela,
// laranja, verde) ficam pro futuro sem migration destrutiva
// (adicionar valores em enum Postgres é additive).
enum Faixa {
  BRANCA
  AZUL
  ROXA
  MARROM
  PRETA
  CORAL
  VERMELHA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  senhaHash    String
  nome         String
  role         Role
  avatarUrl    String?
  // Gate de aprovação para PROFESSOR/NUTRICIONISTA. Aluno entra ativo;
  // perfis profissionais entram inativos até aprovação manual ou
  // verificação de email (decisão de produto pendente).
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  aluno         Aluno?
  professor     Professor?
  nutricionista Nutricionista?

  @@index([role])
  @@index([ativo])
}

model Aluno {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataNascimento  DateTime?
  pesoKg          Float?
  alturaCm        Int?
  stravaUserId    String?  @unique
  stravaToken     String?
  stravaRefresh   String?
  stravaExpiresAt DateTime?

  vinculosProf  VinculoProfessor[]
  vinculosNutri VinculoNutricionista[]
  treinos       Treino[]
  provas        Prova[]
  recordes      RecordePessoal[]
  atividades    AtividadeStrava[]
  rotinas       RotinaMusculacao[]
  evolucoes     EvolucaoCorporal[]
  planos        PlanoAlimentar[]
  promocoes     EvolucaoMarcial[]
}

model Professor {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio    String?

  vinculos          VinculoProfessor[]
  treinosPrescritos Treino[]
  rotinas           RotinaMusculacao[]
}

model Nutricionista {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  crn    String?

  vinculos VinculoNutricionista[]
  planos   PlanoAlimentar[]
}

model VinculoProfessor {
  id          String   @id @default(cuid())
  alunoId     String
  professorId String
  aluno       Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  criadoEm    DateTime  @default(now())

  @@unique([alunoId, professorId])
}

model VinculoNutricionista {
  id              String   @id @default(cuid())
  alunoId         String
  nutricionistaId String
  aluno           Aluno         @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  nutricionista   Nutricionista @relation(fields: [nutricionistaId], references: [id], onDelete: Cascade)
  aceitoPeloAluno Boolean  @default(false)
  criadoEm        DateTime @default(now())

  @@unique([alunoId, nutricionistaId])
  // Listagens "meus alunos aceitos" no dashboard do nutri — filtra por
  // nutricionistaId + aceitoPeloAluno. Sem este índice, table scan em N.
  @@index([nutricionistaId, aceitoPeloAluno])
}

// O "superpoder" JSON: detalhes contém prescricao + (opcional) execucao,
// permitindo que musculação, corrida, natação convivam na mesma tabela.
//
// Exemplo musculação:
// {
//   "tipo": "musculacao",
//   "exercicios": [
//     {
//       "nome": "Supino Inclinado",
//       "videoUrl": "...",
//       "prescrito": { "series": 3, "reps": 12, "cargaPctRP": 70, "descansoSeg": 120 },
//       "realizado": [ { "kg": 32, "reps": 12 }, ... ]
//     }
//   ]
// }
//
// Exemplo corrida:
// { "tipo": "corrida", "distanciaKm": 5, "ritmoAlvoMinKm": "5:30", "realizado": null }
model Treino {
  id          String        @id @default(cuid())
  alunoId     String
  professorId String?
  rotinaId    String?       // null para treinos avulsos (corrida, etc.)
  aluno       Aluno         @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  professor   Professor?    @relation(fields: [professorId], references: [id], onDelete: SetNull)
  rotina      RotinaMusculacao? @relation(fields: [rotinaId], references: [id], onDelete: SetNull)
  modalidade  Modalidade
  titulo      String
  dataAlvo    DateTime
  status      StatusTreino  @default(PENDENTE)
  // jsonb (não json): habilita operadores de containment (@>),
  // índices GIN futuros e armazenamento binário compacto.
  detalhes    Json          @db.JsonB
  iniciadoEm  DateTime?
  finalizadoEm DateTime?
  reagendadoDe DateTime?    // dataAlvo original antes de reagendar
  criadoEm    DateTime      @default(now())
  atualizadoEm DateTime     @updatedAt

  @@index([alunoId, dataAlvo])
  @@index([status])
  // Agregações de desempenho ("treinos concluídos do mês", streak semanal)
  // filtram por aluno + finalizadoEm. Índice composto evita table scan.
  @@index([alunoId, finalizadoEm])
  // GIN com jsonb_path_ops — suporta operator @> usado em historicoCargas.
  // Aplicado no PR #7 via raw SQL; declarado aqui no PR #10 pra alinhar
  // o schema com o DB e parar o drift detection do Prisma.
  @@index([detalhes(ops: JsonbPathOps)], type: Gin, map: "Treino_detalhes_gin_idx")
}

model Prova {
  id         String   @id @default(cuid())
  alunoId    String
  aluno      Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  modalidade Modalidade
  nome       String
  data       DateTime
  detalhes   Json     @db.JsonB
  criadoEm   DateTime @default(now())

  @@index([alunoId, data])
}

// Modelo de RP "ativo": uma linha por combinação (alunoId, exercicio,
// metrica, reps). Quando o aluno bate um valor maior, a linha é
// ATUALIZADA (valor + treinoId + dataRecorde) em vez de criar histórico.
// Trade-off consciente do PR #10: simplifica race protection e o modelo
// de leitura. Histórico granular de evolução do RP fica derivável das
// execuções (Treino.detalhes) caso necessário no futuro.
model RecordePessoal {
  id         String     @id @default(cuid())
  alunoId    String
  aluno      Aluno      @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  modalidade Modalidade
  exercicio  String     // ex: "Supino Inclinado", "5km", "100m livre"
  metrica    String     // ex: "kg_x_reps", "tempo", "distancia"
  valor      Float      // ex: 32.0 (kg), 1290 (segundos), 5000 (metros)
  unidade    String     // ex: "kg", "s", "m"
  reps       Int?
  dataRecorde DateTime  @default(now())
  treinoId   String?

  // Constraint do PR #10: garante 1 RP ativo por combinação no DB.
  // INSERT concorrente com mesma chave gera P2002 — capturado pelo
  // service e tratado como race recovery.
  // Postgres permite duplicatas com reps=NULL (NULL é distinto por
  // default) — pra resolver isso no caso de pace (endurance), o PR #19
  // adicionou via raw SQL um UNIQUE PARCIAL `RecordePessoal_pace_unq`:
  //   ON (alunoId, exercicio, metrica) WHERE reps IS NULL
  // Prisma migrate ainda não emite o WHERE em unique nativo; o índice
  // vive na migration `20260517190000_rp_pace_unique`. Service captura
  // P2002 e aplica update lower-is-better via predicado `valor > novo`.
  @@unique([alunoId, exercicio, metrica, reps], name: "RecordePessoal_ativo_unq")
  @@index([alunoId, exercicio])
}

model AtividadeStrava {
  id           String   @id @default(cuid())
  alunoId      String
  aluno        Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  stravaId     String   @unique
  tipo         String   // Run, Ride, Swim, etc.
  nome         String
  distanciaM   Float
  duracaoSeg   Int
  ritmoMedio   Float?
  fcMedia      Int?
  iniciadoEm   DateTime
  payloadRaw   Json     @db.JsonB
  sincronizadoEm DateTime @default(now())

  @@index([alunoId, iniciadoEm])
}

// ──────────────────────────────────────────────────────────────
// Catálogo global de exercícios — cadastrado por professor.
// Compartilhado entre todos os professores e reutilizado em rotinas.
// ──────────────────────────────────────────────────────────────
model Exercicio {
  id              String         @id @default(cuid())
  nome            String         @unique
  videoUrl        String?
  imagemUrl       String?
  grupoMuscular   GrupoMuscular?
  equipamento     String?        // ex: "Barra", "Halter", "Máquina"
  instrucoes      String?        // dicas curtas de execução
  criadoPorId     String?        // Professor.id (opcional para seed)
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt

  // PR #22 — domínio (musculação/BJJ/etc) + campos opcionais p/ BJJ.
  // Default MUSCULACAO preserva o catálogo histórico sem backfill.
  dominio         DominioExercicio @default(MUSCULACAO)
  // Posição inicial / contexto do movimento. Texto livre porque BJJ
  // tem nomenclatura regional (ex: "guarda fechada" vs "guarda
  // borboleta" vs "100 quilos"). Cap em 80 no Zod.
  posicao         String?
  // Categoria do movimento — usado pelo picker da UI pra agrupar
  // "Passagens", "Submissões", etc na visão do mestre.
  tipoMovimento   TipoMovimento?

  rotinaExercicios RotinaExercicio[]

  @@index([grupoMuscular])
  @@index([dominio])
  @@index([dominio, tipoMovimento])
}

// ──────────────────────────────────────────────────────────────
// Rotina de musculação — template prescrito para um aluno em um
// dia da semana, válido em uma janela (vigência). Não tem sets
// realizados — esses ficam nas instâncias `Treino` geradas a partir
// dela quando o aluno executa.
// ──────────────────────────────────────────────────────────────
model RotinaMusculacao {
  id              String     @id @default(cuid())
  alunoId         String
  professorId     String
  nome            String     // ex: "Treino A — Peito + Tríceps"
  diaSemana       DiaSemana
  vigenciaInicio  DateTime
  vigenciaFim     DateTime?  // null = rotina aberta (sem fim)
  criadoEm        DateTime   @default(now())
  atualizadoEm    DateTime   @updatedAt

  aluno      Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  professor  Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  exercicios RotinaExercicio[]
  treinos    Treino[]  // instâncias geradas

  @@index([alunoId, diaSemana])
  @@index([alunoId, vigenciaInicio, vigenciaFim])
}

// Vínculo exercício → rotina, com prescrição inline.
model RotinaExercicio {
  id          String   @id @default(cuid())
  rotinaId    String
  exercicioId String
  ordem       Int
  series      Int
  reps        Int?
  repsMin     Int?
  repsMax     Int?
  cargaPctRP  Float?
  cargaKg     Float?
  descansoSeg Int?
  observacao  String?

  rotina    RotinaMusculacao @relation(fields: [rotinaId], references: [id], onDelete: Cascade)
  exercicio Exercicio        @relation(fields: [exercicioId], references: [id], onDelete: Restrict)

  @@unique([rotinaId, ordem])
  @@index([rotinaId])
}

// ──────────────────────────────────────────────────────────────
// Evolução corporal / Avaliação física
// Modelo modular: campos básicos sempre presentes; o JSON `medidas`
// acomoda tanto auto-avaliação simples (cintura/peso) quanto o
// protocolo profissional ISAK (8 dobras + 5 perímetros + 2 diâmetros).
// `avaliadorTipo` audita a confiabilidade do dado.
//
// Exemplo medidas (auto-avaliação):
// { "tipo": "ALUNO_FITA", "cinturaCm": 84, "quadrilCm": 96 }
//
// Exemplo medidas (ISAK profissional):
// {
//   "tipo": "ISAK_RESTRITO",
//   "dobras": { "triceps": 12, "subescapular": 14, "biceps": 6, ... },
//   "perimetros": { "braco": 32, "cintura": 78, ... },
//   "diametros": { "umeral": 7.1, "femoral": 9.4 }
// }
// ──────────────────────────────────────────────────────────────
model EvolucaoCorporal {
  id                String        @id @default(cuid())
  alunoId           String
  aluno             Aluno         @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  avaliadorId       String?       // userId de quem registrou (Aluno=próprio, Nutri/Prof=outro)
  avaliadorTipo     AvaliadorTipo
  dataAvaliacao     DateTime      @default(now())

  // Antropometria básica — presente em todas as variantes
  pesoKg            Float?
  alturaCm          Int?

  // Cálculos derivados — calculados no servidor a partir de `medidas`
  imc               Float?
  percentualGordura Float?
  // Protocolo de cálculo: 'JP3', 'JP4', 'JP7', 'DURNIN_WOMERSLEY',
  // 'ALUNO_FITA', 'ISAK_RESTRITO', 'OUTRO'
  protocolo         String?

  // JSON flexível: simples (cintura única) ou ISAK completo
  medidas           Json?         @db.JsonB

  // { frente: "url", lado: "url", costas: "url", extras: ["url"] }
  fotos             Json?         @db.JsonB

  observacoes       String?

  criadoEm          DateTime      @default(now())
  atualizadoEm      DateTime      @updatedAt

  @@index([alunoId, dataAvaliacao])
  @@index([avaliadorTipo])
}

// ──────────────────────────────────────────────────────────────
// PlanoAlimentar — PR #18b (Sprint 6)
//
// Decisão de produto: NÃO modelamos refeições estruturadas. Nutris já
// usam software dedicado (WebDiet/Dietbox) que exporta PDF. Esta tabela
// só guarda referência ao PDF (via S3) + campo livre de "foco/metas".
// Quando precisarmos de tracking estruturado (kcal, macros, refeições),
// adicionamos um modelo separado sem migrar este.
//
// "ativo" é mantido pelo service via $transaction: criar novo plano
// desativa todos os anteriores do mesmo aluno. Não usamos partial
// unique index porque Postgres exige sintaxe que o Prisma migrate
// engine ainda não emite sem fallback de raw SQL.
// ──────────────────────────────────────────────────────────────
model PlanoAlimentar {
  id              String         @id @default(cuid())
  alunoId         String
  aluno           Aluno          @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  nutricionistaId String?
  nutricionista   Nutricionista? @relation(fields: [nutricionistaId], references: [id], onDelete: SetNull)

  // URL pública do PDF (S3 / CloudFront). Backend valida contra a
  // allowlist `isAllowedAssetUrl` (PR #13, audit 2.23) no schema Zod.
  pdfUrl          String
  // Key S3 mantida pra DELETE/replace futuro sem precisar parsear a URL.
  pdfKey          String?

  // Texto livre de "Foco/Metas da Dieta" — input do nutri.
  metasText       String?
  // Default true; service desativa os antigos ao criar um novo.
  ativo           Boolean        @default(true)

  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt

  // Query principal: "plano vigente do aluno" → filtra por (alunoId, ativo=true).
  @@index([alunoId, ativo])
}

// ──────────────────────────────────────────────────────────────
// PR #24 — Jornada do Faixa Preta (BJJ).
//
// Cada promoção é uma linha imutável (não atualizamos; corrigir =
// criar nova linha + deletar anterior). Sequência cronológica permite
// reconstruir a linha do tempo do atleta sem state mutável.
//
// `instrutorNome` é texto livre (não FK a Professor): cobre o caso
// comum do atleta receber faixa de mestre externo à plataforma.
//
// Query principal "faixa atual" = LIMIT 1 ordenado por dataPromocao
// DESC. Índice composto cobre a query sem table scan mesmo com
// histórico longo.
// ──────────────────────────────────────────────────────────────
model EvolucaoMarcial {
  id              String   @id @default(cuid())
  alunoId         String
  aluno           Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  faixa           Faixa
  // Grau (degrau/stripe na ponta da faixa): 0..4 antes da próxima
  // graduação. Modelado como int simples — 5 é o salto de faixa.
  grauNum         Int      @default(0)

  dataPromocao    DateTime
  instrutorNome   String?  // texto livre, max 120 no Zod
  observacao      String?  // anotação opcional do mestre/atleta

  criadoEm        DateTime @default(now())

  // Query "faixa atual" filtra por alunoId e ordena por dataPromocao
  // DESC com LIMIT 1. Índice composto cobre sem table scan.
  @@index([alunoId, dataPromocao])
}
