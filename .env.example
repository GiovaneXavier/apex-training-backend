# Apex Training Backend — environment example
# Copy to .env and fill in values.

# Server
# Em Render/Vercel/Railway o PORT é injetado pela plataforma — deixe vazio em prod.
PORT=3333
NODE_ENV=development

# Origem do frontend deployado (Vercel). Source-of-truth em produção.
FRONTEND_URL=https://apex-training.vercel.app
# Lista CSV adicional de origens permitidas (dev local, staging, IP da LAN).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Database — Neon.tech (zero-cost Postgres serverless)
# DATABASE_URL: connection string POOLED (host com '-pooler') usada em runtime.
# DIRECT_URL: connection string DIRETA (sem pooler) usada por prisma migrate.
# Pegue ambas em https://console.neon.tech → Connection Details
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.sa-east-1.aws.neon.tech/apex_training?sslmode=require&pgbouncer=true&connect_timeout=10"
DIRECT_URL="postgresql://USER:PASS@ep-xxx.sa-east-1.aws.neon.tech/apex_training?sslmode=require"

# Auth — gere um valor forte com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Strava OAuth
# Crie a app em https://www.strava.com/settings/api
# Authorization Callback Domain (sem protocolo): localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Redirect URI usado pelo frontend ao iniciar OAuth
STRAVA_REDIRECT_URI=http://localhost:5173/strava/callback
# Chave AES-256 (32 bytes base64) para criptografar tokens Strava no banco.
# OBRIGATÓRIA em produção. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STRAVA_TOKEN_KEY=

# Strava Webhook (PR #41a / Sprint 15)
# Opcional — se configurado, atividades novas chegam push (sem polling).
# VERIFY_TOKEN: string aleatória >=16 chars. Strava ecoa este valor no
# GET de validação inicial; nossos endpoints comparam constant-time.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
STRAVA_VERIFY_TOKEN=
# URL pública do endpoint POST /api/strava/webhook.
# Dev: use ngrok (https://NNN.ngrok.io/api/strava/webhook)
# Prod: https://<seu-render-domain>/api/strava/webhook
STRAVA_WEBHOOK_CALLBACK_URL=

# AWS S3 — fotos de evolução via presigned URL
# Em produção, prefira IAM Role (EC2/ECS/Lambda) e omita ACCESS_KEY/SECRET.
AWS_REGION=sa-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# CDN opcional (CloudFront). Se vazio, publicUrl usa endpoint S3 direto.
CDN_BASE_URL=
