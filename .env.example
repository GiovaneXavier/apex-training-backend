# Apex Training Backend — environment example
# Copy to .env and fill in values.

# Server
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apex_training?schema=public"

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Strava OAuth (Sprint 5)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3333/api/strava/callback
