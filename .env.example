# Apex Training Backend — environment example
# Copy to .env and fill in values.

# Server
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apex_training?schema=public"

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Strava OAuth (Sprint 5)
# Crie a app em https://www.strava.com/settings/api
# Authorization Callback Domain (sem protocolo): localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Redirect URI usado pelo frontend ao iniciar OAuth
STRAVA_REDIRECT_URI=http://localhost:5173/strava/callback
